# Global .gitignore for monorepo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Node modules
node_modules/

# Build output
/dist/
dist/
dist-ssr/

# Coverage
/coverage/
/.nyc_output/

# OS
.DS_Store

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.development
.env.production
*.local

# TypeORM
/migrations/*.js
