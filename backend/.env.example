# ── Database (PostgreSQL) ───────────────────────────────
DB_HOST=localhost              # PostgreSQL host
DB_PORT=5432                   # PostgreSQL port
DB_USERNAME=postgres           # Database user
DB_PASSWORD=change_me          # Database password
DB_DATABASE=novainvoice        # Database name (create it first: CREATE DATABASE novainvoice;)

# ── JWT authentication ──────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string          # Secret used to sign access tokens
JWT_EXPIRES_IN=15m                                    # Access token lifetime
JWT_REFRESH_SECRET=replace-with-another-random-string # Secret used to sign refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_EXPIRES_IN=7d                             # Refresh token lifetime

# ── Server ──────────────────────────────────────────────
PORT=3000                      # HTTP port of the API
NODE_ENV=development           # "development" enables TypeORM synchronize + SQL logging

# ── AI (optional) ───────────────────────────────────────
GEMINI_API_KEY=                # Google Gemini API key; leave empty to disable AI insights (endpoint returns 503)

# ── Initial platform admin (used by `npm run seed:admin`) ─
ADMIN_EMAIL=admin@example.com  # Email of the platform_admin account to create
ADMIN_PASSWORD=change_me_now   # Password (min. 8 characters) — change it after first login
